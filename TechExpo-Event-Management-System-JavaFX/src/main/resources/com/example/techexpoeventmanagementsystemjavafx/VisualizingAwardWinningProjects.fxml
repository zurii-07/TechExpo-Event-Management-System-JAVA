<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="598.0" prefWidth="760.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.techexpoeventmanagementsystemjavafx.VisualizingAwardWinningProjectsController">
    <BarChart fx:id="barChart" layoutX="17.0" layoutY="90.0" prefHeight="450.0" prefWidth="724.0">
        <xAxis>
            <CategoryAxis label="Projects" />
        </xAxis>
        <yAxis>
            <NumberAxis fx:id="numberAxis" label="Scores" tickUnit="20" />
        </yAxis>
    </BarChart>
    <Button layoutX="320.0" layoutY="550.0" mnemonicParsing="false" onAction="#handleBackToMainMenu" prefHeight="33.0" prefWidth="150.0" text="Back to Main Menu" />
    <Label layoutX="115.0" layoutY="31.0" text="TechExpo Event Management System" textFill="#00966e">
        <font>
            <Font name="System Bold" size="30.0" />
        </font>
    </Label>
</AnchorPane>
